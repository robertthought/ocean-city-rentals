<div class="max-w-4xl mx-auto">
  <div class="flex items-center justify-between mb-8">
    <div class="flex items-center gap-4">
      <%= link_to admin_leads_path, class: "p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
      <% end %>
      <h1 class="text-3xl font-bold text-gray-900">Lead Details</h1>
    </div>
    <div class="flex items-center gap-2">
      <% if @lead.contacted %>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
          Contacted
        </span>
      <% else %>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-orange-100 text-orange-800">
          New
        </span>
        <%= button_to mark_contacted_admin_lead_path(@lead),
          method: :post,
          class: "px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors font-semibold" do %>
          Mark as Contacted
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="grid lg:grid-cols-3 gap-6">
    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Contact Info Card -->
      <div class="bg-white rounded-xl shadow p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4">Contact Information</h2>

        <div class="space-y-4">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
              <span class="text-blue-600 font-bold text-lg"><%= @lead.name.split.map(&:first).join.upcase[0..1] %></span>
            </div>
            <div>
              <p class="font-semibold text-gray-900 text-lg"><%= @lead.name %></p>
              <p class="text-sm text-gray-500">Lead Type: <%= @lead.lead_type&.titleize || "Rental Inquiry" %></p>
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-4 pt-4 border-t border-gray-100">
            <div>
              <p class="text-sm text-gray-500 mb-1">Email</p>
              <a href="mailto:<%= @lead.email %>" class="text-blue-600 hover:text-blue-700 font-medium">
                <%= @lead.email %>
              </a>
            </div>
            <div>
              <p class="text-sm text-gray-500 mb-1">Phone</p>
              <% if @lead.phone.present? %>
                <a href="tel:<%= @lead.phone %>" class="text-blue-600 hover:text-blue-700 font-medium">
                  <%= @lead.phone %>
                </a>
              <% else %>
                <span class="text-gray-400">Not provided</span>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Message Card -->
      <div class="bg-white rounded-xl shadow p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4">Message</h2>
        <% if @lead.message.present? %>
          <div class="bg-gray-50 rounded-lg p-4">
            <p class="text-gray-700 whitespace-pre-wrap"><%= @lead.message %></p>
          </div>
        <% else %>
          <p class="text-gray-400 italic">No message provided</p>
        <% end %>
      </div>

      <!-- Property Card -->
      <div class="bg-white rounded-xl shadow p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4">Property of Interest</h2>
        <%= link_to property_path(@lead.property), target: "_blank", class: "block" do %>
          <div class="flex items-start gap-4 p-4 bg-gray-50 rounded-lg hover:bg-blue-50 transition-colors">
            <% if @lead.property.primary_photo_url.present? %>
              <img src="<%= @lead.property.primary_photo_url %>" alt="<%= @lead.property.address %>"
                   class="w-24 h-24 object-cover rounded-lg">
            <% else %>
              <div class="w-24 h-24 bg-gray-200 rounded-lg flex items-center justify-center">
                <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                </svg>
              </div>
            <% end %>
            <div class="flex-1">
              <p class="font-semibold text-gray-900"><%= @lead.property.address %></p>
              <p class="text-sm text-gray-500"><%= @lead.property.city %>, <%= @lead.property.state %> <%= @lead.property.zip %></p>
              <div class="flex items-center gap-4 mt-2 text-sm text-gray-600">
                <span><%= @lead.property.bedrooms %> bed</span>
                <span><%= @lead.property.bathrooms %> bath</span>
                <% if @lead.property.occupancy_limit.present? %>
                  <span>Sleeps <%= @lead.property.occupancy_limit %></span>
                <% end %>
              </div>
            </div>
            <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
            </svg>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- Quick Actions -->
      <div class="bg-white rounded-xl shadow p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4">Quick Actions</h2>
        <div class="space-y-3">
          <a href="mailto:<%= @lead.email %>?subject=Re: <%= @lead.property.address %> Rental Inquiry"
             class="flex items-center gap-3 w-full px-4 py-3 bg-blue-50 text-blue-700 rounded-lg hover:bg-blue-100 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <span class="font-medium">Send Email</span>
          </a>
          <% if @lead.phone.present? %>
            <a href="tel:<%= @lead.phone %>"
               class="flex items-center gap-3 w-full px-4 py-3 bg-green-50 text-green-700 rounded-lg hover:bg-green-100 transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
              <span class="font-medium">Call <%= @lead.phone %></span>
            </a>
          <% end %>
        </div>
      </div>

      <!-- Meta Info -->
      <div class="bg-white rounded-xl shadow p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4">Details</h2>
        <dl class="space-y-3 text-sm">
          <div class="flex justify-between">
            <dt class="text-gray-500">Submitted</dt>
            <dd class="text-gray-900 font-medium"><%= @lead.created_at.strftime("%b %d, %Y at %I:%M %p") %></dd>
          </div>
          <% if @lead.contacted && @lead.contacted_at %>
            <div class="flex justify-between">
              <dt class="text-gray-500">Contacted</dt>
              <dd class="text-gray-900 font-medium"><%= @lead.contacted_at.strftime("%b %d, %Y at %I:%M %p") %></dd>
            </div>
          <% end %>
          <% if @lead.source.present? %>
            <div class="flex justify-between">
              <dt class="text-gray-500">Source</dt>
              <dd class="text-gray-900 font-medium"><%= @lead.source %></dd>
            </div>
          <% end %>
          <% if @lead.recaptcha_score.present? %>
            <div class="flex justify-between">
              <dt class="text-gray-500">reCAPTCHA Score</dt>
              <dd class="text-gray-900 font-medium"><%= @lead.recaptcha_score %></dd>
            </div>
          <% end %>
          <% if @lead.ip_address.present? %>
            <div class="flex justify-between">
              <dt class="text-gray-500">IP Address</dt>
              <dd class="text-gray-900 font-medium"><%= @lead.ip_address %></dd>
            </div>
          <% end %>
        </dl>
      </div>

      <!-- Danger Zone -->
      <div class="bg-white rounded-xl shadow p-6 border border-red-100">
        <h2 class="text-lg font-bold text-red-600 mb-4">Danger Zone</h2>
        <%= button_to admin_lead_path(@lead),
          method: :delete,
          class: "w-full px-4 py-2 bg-red-50 text-red-600 rounded-lg hover:bg-red-100 transition-colors font-medium",
          data: { turbo_confirm: "Are you sure you want to delete this lead? This cannot be undone." } do %>
          Delete Lead
        <% end %>
      </div>
    </div>
  </div>
</div>
